# ==============================================================================
# PAYAGENT OS (NEXUSPAY AI) - CONFIGURATION & CREDENTIALS
# ==============================================================================
# DIEM CHO CREDENTIALS CUA USER:
# Khi ban nhan duoc credentials tu PayPal Developer Dashboard (https://developer.paypal.com/dashboard/applications/sandbox),
# hay sao chep file nay thanh `.env` va dien PAYPAL_CLIENT_ID & PAYPAL_CLIENT_SECRET.
#
# Neu chua co credentials (hoac de placeholder), he thong se TU DONG kich hoat
# Mock Sandbox Driver voi day du tinh nang va do trung thuc 100% theo chuan PayPal REST v2.
# ==============================================================================

# Che do chay: "auto" (tu dong chon: sandbox neu co key, mock neu key placeholder), "sandbox" (ep buoc), "mock" (ep buoc)
PAYPAL_MODE=auto

# PayPal Sandbox API Base URL
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Sandbox App Credentials
# Dien vao day khi muon test truc tiep tren Sandbox live cua PayPal:
PAYPAL_CLIENT_ID=PLACEHOLDER_PAYPAL_CLIENT_ID_WAITING_FOR_USER
PAYPAL_CLIENT_SECRET=PLACEHOLDER_PAYPAL_CLIENT_SECRET_WAITING_FOR_USER

# Port cho ung dung web
PORT=3000
NODE_ENV=development

# Agent Governance & Policy Limits (USD)
AGENT_MAX_TRANSACTION_LIMIT=500.00
AGENT_DAILY_SPEND_LIMIT=2500.00
AGENT_REQUIRE_APPROVAL_THRESHOLD=250.00

# Mock latency (ms) cho che do Mock Sandbox
PAYPAL_MOCK_LATENCY_MS=60
